{
    $schema: "https://docs.renovatebot.com/renovate-schema.json",
    customManagers: [
        {
            // Targets `.yaml`, `.yml`, `.env`, and `.sh` files. Extend
            // `managerFilePatterns` for other formats (TOML, JSON, INI). The
            // regex won't capture versions embedded mid-string (e.g. inside a
            // URL path) — use a dedicated manager for those.
            customType: "regex",
            description: "Pick up dependencies annotated with `# renovate: datasource=X depName=Y` comments (yaml/env/sh; handles `:`, `=`, YAML anchors, quoted values)",
            managerFilePatterns: [
                "/\\.env(?:\\.j2)?$/",
                "/\\.sh(?:\\.j2)?$/",
                "/\\.ya?ml(?:\\.j2)?$/",
            ],
            matchStrings: [
                "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+(:\\s|=)(&\\S+\\s)?[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
            ],
            datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
        },
    ],
}
